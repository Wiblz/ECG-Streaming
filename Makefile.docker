# Docker-specific commands for ECG Streaming
# This file is included by the main Makefile

.PHONY: docker-build docker-up docker-up-usb docker-up-aggregator docker-up-collector docker-down docker-logs docker-clean docker-pull docker-prod

# Build all Docker images
docker-build:
	@echo "Building Docker images..."
	docker compose build
	@echo "✓ Docker images built"

# Start all services with BLE collector
docker-up:
	@echo "Starting services with BLE collector..."
	docker compose up -d
	@echo "✓ Services started"
	@echo "  - Aggregator: http://localhost:50051"
	@echo "  - Frontend: http://localhost:4173"

# Start all services with USB collector
docker-up-usb:
	@echo "Starting services with USB collector..."
	docker compose -f docker-compose.yml -f docker-compose.usb.yml up -d
	@echo "✓ Services started"
	@echo "  - Aggregator: http://localhost:50051"
	@echo "  - Frontend: http://localhost:4173"

# Start aggregator + frontend only
docker-up-aggregator:
	@echo "Starting aggregator + frontend only..."
	docker compose -f docker-compose.yml -f docker-compose.aggregator-only.yml up -d
	@echo "✓ Services started"
	@echo "  - Aggregator: http://localhost:50051"
	@echo "  - Frontend: http://localhost:4173"
	@echo "  - Note: Run collector separately (native or Docker)"

# Start collector only (BLE mode)
docker-up-collector:
	@echo "Starting collector only (BLE mode)..."
	@echo "Note: Requires external aggregator running"
	docker compose -f docker-compose.yml -f docker-compose.collector-only.yml up -d
	@echo "✓ Collector started"
	@echo "  - Make sure aggregator is accessible (update config.yaml)"

# Stop all services (handles both BLE and USB modes)
docker-down:
	@echo "Stopping services..."
	@docker compose -f docker-compose.yml -f docker-compose.usb.yml down 2>/dev/null || true
	@docker compose -f docker-compose.yml -f docker-compose.aggregator-only.yml down 2>/dev/null || true
	@docker compose -f docker-compose.yml -f docker-compose.collector-only.yml down 2>/dev/null || true
	@docker compose down
	@echo "✓ Services stopped"

# Follow logs from all services
docker-logs:
	@echo "Following logs (Ctrl+C to stop)..."
	docker compose logs -f

# Clean up Docker environment
docker-clean:
	@echo "Stopping and removing all containers, networks, and volumes..."
	@docker compose -f docker-compose.yml -f docker-compose.usb.yml down -v 2>/dev/null || true
	@docker compose -f docker-compose.yml -f docker-compose.aggregator-only.yml down -v 2>/dev/null || true
	@docker compose -f docker-compose.yml -f docker-compose.collector-only.yml down -v 2>/dev/null || true
	@docker compose down -v
	@echo "✓ Docker environment cleaned"

# Pull pre-built images from GitHub Container Registry
docker-pull:
	@echo "Pulling images from GHCR..."
	docker compose -f docker-compose.prod.yml pull
	@echo "✓ Images pulled"

# Run production stack with pre-built images
docker-prod:
	@echo "Starting production stack from GHCR images..."
	@echo "Note: Set GITHUB_REPOSITORY and IMAGE_TAG environment variables"
	docker compose -f docker-compose.prod.yml up -d
	@echo "✓ Services started"
	@echo "  - Aggregator: http://localhost:50051"
	@echo "  - Frontend: http://localhost:4173"