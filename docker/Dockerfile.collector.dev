# ECG Collector - Development with hot reload
FROM python:3.14-slim

# Install system dependencies for BLE and USB
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    bluez \
    bluetooth \
    libbluetooth-dev \
    libdbus-1-dev \
    udev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install uv for fast package installation
RUN pip install --no-cache-dir uv

# Install watchfiles for hot reload support
RUN pip install --no-cache-dir watchfiles

# Copy source code for initial install
COPY packages/ecg-common /app/packages/ecg-common
COPY packages/ecg-collector /app/packages/ecg-collector
COPY pyproject.toml /app/

# Install packages in editable mode with dev dependencies
# When volumes are mounted, editable installs will pick up changes automatically
# Use service-specific cache mount to avoid lock contention with aggregator
RUN --mount=type=cache,target=/root/.cache/uv-collector \
    uv pip install --system -e "packages/ecg-common[dev]"
RUN --mount=type=cache,target=/root/.cache/uv-collector \
    uv pip install --system -e "packages/ecg-collector[dev]"

# Run with watchfiles to restart on code changes
# Use python -m to avoid issues with entry points when volumes are mounted
# Command will be overridden in docker-compose for ble/usb modes
CMD ["watchfiles", "--filter", "python", "python -m ecg_collector.cli ble run --config /app/config.yaml", "/app/packages"]
