# ECG Aggregator - Development with hot reload
FROM python:3.14-slim

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install uv for fast package installation
RUN pip install --no-cache-dir uv

# Install watchfiles for hot reload support
RUN pip install --no-cache-dir watchfiles

# Copy source code for initial install
COPY packages/ecg-common /app/packages/ecg-common
COPY packages/ecg-aggregator /app/packages/ecg-aggregator
COPY pyproject.toml /app/

# Install packages in editable mode
# When volumes are mounted, editable installs will pick up changes automatically
# Use service-specific cache mount to avoid lock contention with collector
RUN --mount=type=cache,target=/root/.cache/uv-aggregator \
    uv pip install --system -e packages/ecg-common
RUN --mount=type=cache,target=/root/.cache/uv-aggregator \
    uv pip install --system -e packages/ecg-aggregator

# Expose ports (gRPC and HTTP API)
EXPOSE 50051 7999

# Run with watchfiles to restart on code changes
# Use python -m to avoid issues with entry points when volumes are mounted
CMD ["watchfiles", "--filter", "python", "python -m ecg_aggregator.cli run --config /app/config.yaml", "/app/packages"]
